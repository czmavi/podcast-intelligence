APP_ENV=development
APP_BASE_URL=http://localhost:8000

DATABASE_URL=postgres://podcast:podcast@localhost:5432/podcast
POSTGRES_PORT=5432

STORAGE_ROOT=./storage
AUDIO_ML_URL=http://localhost:8001
AUDIO_ML_API_TOKEN=
AUDIO_ML_SHARED_ROOT=/data
AUDIO_ML_IDLE_TIMEOUT_MS=1800000

SPARK_HOST=gx10-d8fb
SPARK_USER=mvich
NAS_HOST=192.168.1.112
NAS_SHARE=Podcasts
NAS_USERNAME=Podcast
NAS_PASSWORD=
NAS_ANSIBLE_USER=
NAS_ANSIBLE_PASSWORD=

HF_TOKEN=
OPENAI_API_KEY=
OPENAI_ANSWER_MODEL=gpt-5.6-luna
OPENAI_ANSWER_TIMEOUT_MS=180000
OPENAI_ANSWER_MAX_TOKENS=4000
OPENAI_ANSWER_REASONING_EFFORT=low

# Volitelný lokální RAG model přes OpenAI-kompatibilní API (např. vLLM/llama.cpp).
# Ponechte disabled, dokud samostatný model server neběží a není ověřený mimo audio pipeline.
ANSWER_GENERATION_PROVIDER=disabled
ANSWER_GENERATION_BASE_URL=http://gx10-d8fb:8002/v1
ANSWER_GENERATION_MODEL=bottlecapai/ThinkingCap-Qwen3.6-27B-NVFP4
ANSWER_GENERATION_API_KEY=
ANSWER_GENERATION_TIMEOUT_MS=180000
ANSWER_GENERATION_MAX_TOKENS=1200
ANSWER_GENERATION_REASONING_EFFORT=none
ANSWER_GENERATION_THINKING_TOKEN_BUDGET=2048

# Kontextová oprava ASR se spouští pouze v režimu overlap_asr_corrected.
# Context size je počet sekund na každé straně cílové promluvy.
ASR_CORRECTION_MODEL=
ASR_CORRECTION_AUTO_APPLY_THRESHOLD=0.85
ASR_CORRECTION_CONCURRENCY=4
ASR_CORRECTION_CONTEXT_SIZE=90

DEFAULT_TRANSCRIPTION_LANGUAGE=cs
AUDIO_PIPELINE_MAX_CONCURRENCY=1
TRANSCRIPTION_CHECKPOINT_ROOT=/checkpoints
TRANSCRIPTION_CHUNK_MAX_ATTEMPTS=3
TRANSCRIPTION_CHUNK_RETRY_BASE_SECONDS=2
WHISPER_MODEL=openai/whisper-large-v3
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
SPEAKER_EMBEDDING_MODEL=pyannote/wespeaker-voxceleb-resnet34-LM
TEXT_EMBEDDING_PROVIDER=local
TEXT_EMBEDDING_MODEL=BAAI/bge-m3
TEXT_EMBEDDING_DIMENSIONS=1024
TEXT_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
SEARCH_CANDIDATE_LIMIT=50
SEARCH_MIN_RERANK_SCORE=0.2
SPEAKER_EMBEDDING_DIMENSIONS=256

JOB_POLL_INTERVAL_MS=2000
JOB_LOCK_TIMEOUT_SECONDS=1800
WORKER_CONCURRENCY=2
DOWNLOAD_WORKER_CONCURRENCY=2
AUTO_PROCESS_INTERVAL_MS=60000
MAX_JOB_ATTEMPTS=3

# Volitelné provozní notifikace. Oba Pushover klíče musí být nastavené společně.
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
PUSHOVER_NOTIFICATION_COOLDOWN_MS=10800000

LOG_LEVEL=info
AUTH_MODE=disabled
