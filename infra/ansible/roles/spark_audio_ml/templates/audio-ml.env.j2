AUDIO_ML_SHARED_ROOT=/data
AUDIO_ML_API_TOKEN={{ audio_ml_api_token }}
HF_TOKEN={{ hf_token }}
WHISPER_MODEL={{ whisper_model | default('Cem13/whisper-large-v3-czech', true) }}
WARM_TRANSCRIPTION_MODEL=true
WARM_DIARIZATION_MODEL=true
WARM_SPEAKER_EMBEDDING_MODEL=true
WARM_TEXT_EMBEDDING_MODEL=true
WARM_TEXT_RERANKER_MODEL=true
DIARIZATION_MODEL={{ diarization_model | default('pyannote/speaker-diarization-community-1', true) }}
SPEAKER_EMBEDDING_MODEL={{ speaker_embedding_model | default('pyannote/wespeaker-voxceleb-resnet34-LM', true) }}
TEXT_EMBEDDING_MODEL={{ text_embedding_model | default('BAAI/bge-m3', true) }}
TEXT_RERANKER_MODEL={{ text_reranker_model | default('BAAI/bge-reranker-v2-m3', true) }}
TRANSCRIPTION_CHUNK_SECONDS=300
TRANSCRIPTION_OVERLAP_SECONDS=5
TRANSCRIPTION_TIMESTAMP_MODE=segment
TRANSCRIPTION_CHECKPOINT_ROOT=/checkpoints
TRANSCRIPTION_CHUNK_MAX_ATTEMPTS=3
TRANSCRIPTION_CHUNK_RETRY_BASE_SECONDS=2
DIARIZATION_BRIDGE_MAX_SECONDS=1.2
DIARIZATION_ORPHAN_MAX_SECONDS=0.65
AUDIO_PIPELINE_MAX_CONCURRENCY=1
MODEL_DEVICE=cuda
PYANNOTE_METRICS_ENABLED=0
NAS_HOST={{ nas_host }}
NAS_SHARE={{ nas_share }}
NAS_USERNAME={{ nas_username }}
NAS_PASSWORD={{ nas_password }}
