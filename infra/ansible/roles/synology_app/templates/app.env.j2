APP_ENV=production
APP_BASE_URL=http://{{ ansible_host }}:8000
DATABASE_URL=postgres://podcast:{{ synology_postgres_password }}@postgres:5432/podcast
POSTGRES_PASSWORD={{ synology_postgres_password }}

STORAGE_ROOT=/data
AUDIO_ML_URL={{ audio_ml_url }}
AUDIO_ML_API_TOKEN={{ audio_ml_api_token }}
AUDIO_ML_SHARED_ROOT=/data
AUDIO_ML_IDLE_TIMEOUT_MS={{ audio_ml_idle_timeout_ms | default('1800000', true) }}
DEFAULT_TRANSCRIPTION_LANGUAGE={{ default_transcription_language | default('cs', true) }}

TEXT_EMBEDDING_PROVIDER={{ text_embedding_provider | default('local', true) }}
TEXT_EMBEDDING_MODEL={{ text_embedding_model | default('BAAI/bge-m3', true) }}
TEXT_EMBEDDING_DIMENSIONS={{ text_embedding_dimensions | default('1024', true) }}
TEXT_RERANKER_MODEL={{ text_reranker_model | default('BAAI/bge-reranker-v2-m3', true) }}
SEARCH_CANDIDATE_LIMIT={{ search_candidate_limit | default('50', true) }}
SEARCH_MIN_RERANK_SCORE={{ search_min_rerank_score | default('0.2', true) }}
SPEAKER_EMBEDDING_DIMENSIONS={{ speaker_embedding_dimensions | default('256', true) }}

JOB_POLL_INTERVAL_MS={{ job_poll_interval_ms | default('2000', true) }}
JOB_LOCK_TIMEOUT_SECONDS={{ job_lock_timeout_seconds | default('1800', true) }}
WORKER_CONCURRENCY={{ worker_concurrency | default('1', true) }}
DOWNLOAD_WORKER_CONCURRENCY={{ download_worker_concurrency | default('2', true) }}
AUTO_PROCESS_INTERVAL_MS={{ auto_process_interval_ms | default('60000', true) }}
MAX_JOB_ATTEMPTS={{ max_job_attempts | default('3', true) }}
PUSHOVER_APP_TOKEN={{ pushover_app_token | default('', true) }}
PUSHOVER_USER_KEY={{ pushover_user_key | default('', true) }}
PUSHOVER_NOTIFICATION_COOLDOWN_MS={{ pushover_notification_cooldown_ms | default('10800000', true) }}
LOG_LEVEL={{ log_level | default('info', true) }}
AUTH_MODE={{ auth_mode | default('disabled', true) }}

ANSWER_GENERATION_PROVIDER={{ answer_generation_provider | default('disabled', true) }}
ANSWER_GENERATION_BASE_URL={{ answer_generation_base_url }}
ANSWER_GENERATION_MODEL={{ answer_generation_model | default('bottlecapai/ThinkingCap-Qwen3.6-27B-NVFP4', true) }}
ANSWER_GENERATION_API_KEY={{ answer_generation_api_key }}
ANSWER_GENERATION_TIMEOUT_MS={{ answer_generation_timeout_ms | default('180000', true) }}
ANSWER_GENERATION_MAX_TOKENS={{ answer_generation_max_tokens | default('500', true) }}
ANSWER_GENERATION_REASONING_EFFORT={{ answer_generation_reasoning_effort | default('none', true) }}
ANSWER_GENERATION_THINKING_TOKEN_BUDGET={{ answer_generation_thinking_token_budget | default('2048', true) }}
ASR_CORRECTION_MODEL={{ asr_correction_model | default('', true) }}
ASR_CORRECTION_AUTO_APPLY_THRESHOLD={{ asr_correction_auto_apply_threshold | default('0.85', true) }}
ASR_CORRECTION_CONCURRENCY={{ asr_correction_concurrency | default('4', true) }}
ASR_CORRECTION_CONTEXT_SIZE={{ asr_correction_context_size | default('90', true) }}
OPENAI_API_KEY={{ openai_api_key | default('', true) }}
OPENAI_ANSWER_MODEL={{ openai_answer_model | default('gpt-5.6-luna', true) }}
OPENAI_ANSWER_TIMEOUT_MS={{ openai_answer_timeout_ms | default('180000', true) }}
OPENAI_ANSWER_MAX_TOKENS={{ openai_answer_max_tokens | default('4000', true) }}
OPENAI_ANSWER_REASONING_EFFORT={{ openai_answer_reasoning_effort | default('low', true) }}
