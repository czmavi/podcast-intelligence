{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "lib": ["deno.window", "dom", "dom.iterable"]
  },
  "imports": {
    "postgres": "npm:postgres@3.4.7",
    "zod": "npm:zod@3.25.76",
    "fast-xml-parser": "npm:fast-xml-parser@5.2.5",
    "@std/assert": "jsr:@std/assert@1.0.14",
    "@std/path": "jsr:@std/path@1.1.2"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "tasks": {
    "dev": "deno task dev:web",
    "dev:web": "deno run -A --env-file=.env --watch apps/web/main.ts",
    "dev:worker": "deno run -A --env-file=.env --watch apps/worker/main.ts",
    "check": "deno task fmt:check && deno task lint && deno task typecheck && deno task test:unit",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "typecheck": "deno check apps/web/main.ts apps/worker/main.ts",
    "test": "deno test -A",
    "test:unit": "deno test --allow-env --allow-read packages apps services",
    "test:integration": "deno test -A --env-file=.env --filter='integration:'",
    "db:migrate": "deno run -A --env-file=.env packages/database/migrations.ts up",
    "db:reset": "deno run -A packages/database/migrations.ts reset",
    "db:seed": "deno run -A --env-file=.env scripts/seed.ts",
    "search:reindex": "deno run -A --env-file=.env scripts/reindex-search.ts",
    "storage:recalculate": "deno run -A --env-file=.env scripts/recalculate-storage-usage.ts",
    "audio:benchmark-concurrency": "deno run -A --env-file=.env scripts/benchmark-audio-concurrency.ts",
    "compose:up": "docker compose up --build",
    "compose:down": "docker compose down",
    "compose:nas:up": "docker compose -f docker-compose.yml -f docker-compose.nas.yml up -d --build postgres migrate web worker",
    "compose:nas:down": "docker compose -f docker-compose.yml -f docker-compose.nas.yml down",
    "spark:bootstrap": "ansible-playbook infra/ansible/playbooks/bootstrap.yml",
    "spark:deploy": "ansible-playbook infra/ansible/playbooks/deploy.yml",
    "spark:update": "ansible-playbook infra/ansible/playbooks/update.yml",
    "spark:status": "ansible-playbook infra/ansible/playbooks/status.yml",
    "spark:answer:deploy": "ansible-playbook infra/ansible/playbooks/answer-deploy.yml",
    "spark:answer:status": "ansible-playbook infra/ansible/playbooks/answer-status.yml",
    "synology:bootstrap": "ansible-playbook infra/ansible/playbooks/synology-bootstrap.yml",
    "synology:prepare": "ansible-playbook infra/ansible/playbooks/synology-prepare.yml",
    "synology:deploy": "ansible-playbook infra/ansible/playbooks/synology-deploy.yml",
    "synology:status": "ansible-playbook infra/ansible/playbooks/synology-status.yml"
  }
}
